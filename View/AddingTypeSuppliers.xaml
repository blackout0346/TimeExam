<Window x:Class="TimeExam.AddingTypeSuppliers"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     xmlns:local="clr-namespace:secondExam.View"
     mc:Ignorable="d"
     Title="Добавление поставщика" Height="450" Width="800"  Background="#ABCFCE" >
    <Window.Resources>

        <Style TargetType="{x:Type TextBlock}"  >
            <Setter Property="FontFamily" Value="Comic Sans MS" ></Setter>
            <Setter Property="FontSize" Value="15" ></Setter>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="Comic Sans MS"></Setter>
            <Setter Property="Width" Value="100"></Setter>
            <Setter Property="Height" Value="50"></Setter>
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="FontFamily" Value="Comic Sans MS"></Setter>
        </Style>


    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*">
            </ColumnDefinition>
            <ColumnDefinition Width="*">
            </ColumnDefinition>

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions >
            <RowDefinition >
            </RowDefinition>
            <RowDefinition Height="auto">
            </RowDefinition>
            <RowDefinition>
            </RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock  Text="Мозайка" Grid.ColumnSpan="2" Grid.Row="0" HorizontalAlignment="Right"  Padding="100,10"></TextBlock>
        <Image  Grid.Row="0" Grid.ColumnSpan="2"  Source="/Assets/Mozaikas.png"  Height="100" Width="100" HorizontalAlignment="Right" ></Image>
        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"  Orientation="Vertical">
            <TextBlock Text="Тип поставщика *"></TextBlock>
            <ComboBox x:Name="typeOrg">
                <TextBlock> OOO</TextBlock>
                <TextBlock> ИП</TextBlock>
                <TextBlock> ЗАО</TextBlock>
                <TextBlock> ПАО</TextBlock>
            </ComboBox>
            <TextBlock><Run Text="Наименование "/><Run Language="ru-ru" Text="поставщика"/><Run Text=" *"/></TextBlock>
            <TextBox x:Name="NameSup"></TextBox>


            <TextBlock Text="ИНН *"></TextBlock>
            <TextBox x:Name="INN" ></TextBox>
            <TextBlock Text="Рейтинг (0-10) *"></TextBlock>
            <TextBox x:Name="Rate" ></TextBox>

        </StackPanel>
        <TextBlock  Grid.Column="0" Grid.ColumnSpan="2" Text="Добавление Поставщиков" FontSize="20" FontWeight="Bold" Grid.Row="0" Padding="10, 10"   ></TextBlock>
        <TextBlock Text="Добавление Поставщиков" Padding="10, 40"></TextBlock>
        <Button  Grid.Column="0"  Grid.Row="3" Foreground="White" Content="Принять" HorizontalAlignment="Center" Background="#546F94" Click="Button_Click_1" ></Button>
        <Button  Grid.Column="1"  Grid.ColumnSpan="2" Grid.Row="3" Foreground="White" Content="Отмена" HorizontalAlignment="Center" Background="#546F94" Click="Button_Click" ></Button>


    </Grid>
</Window>
